# A list of files for `git` to ignore.

# Generated by running `bootstrap.py`.
test_results.txt

# Mercurial holds the checkpoint history; git holds only curated commits.
.hg/
.hgignore
.hgtags

# Stuff left over by testing.
trace_hook/

# Some Python testing leaves stuff behind that needs to be ignored.
__pycache__/

# A symbolic link to a Python comments style guide.
python_with_markdown.md


# Editor backups.  Git needs the leading hash escaped, because an
# unescaped one would start a comment and ignore nothing.
*~
\#*#
.#*

# Symbolic links to sibling projects, which would dangle on GitHub.
aic
ai_contexts
claude_notes.md

# Wheels built by release.py.
dist/

# Notes on publishing, kept for reuse in other projects.
PyPI_Via_GitHub.md
